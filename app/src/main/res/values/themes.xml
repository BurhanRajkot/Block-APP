<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background only — everything else Compose draws is themed via BlockAppTheme in
         MainActivity. This just stops the system's default window background from flashing
         before the first Compose frame lands. Dark in both system modes because the Compose
         theme is dark-only (see ui/theme/Color.kt); Ink950 there. -->
    <style name="Theme.BlockApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E0F0C</item>
        <item name="android:statusBarColor">#0E0F0C</item>
        <item name="android:navigationBarColor">#141512</item>
    </style>
</resources>
